# Copy to .env (Copy-Item .env.example .env). Never commit .env.
LOG_LEVEL=INFO

# --- Model ---
MODEL_PATH=model/artifacts/model.pt
# Benchmark knob: extra forward passes per request to emulate a heavier model (0 = real model only).
EXTRA_FORWARD_PASSES=0

# --- Redis / cache ---
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=0.25
REDIS_MAX_CONNECTIONS=64
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_NAMESPACE=infer
# bypass = serve predictions without cache if Redis is down; fail = return 503
CACHE_FAILURE_POLICY=bypass
CACHE_RETRY_AFTER_SECONDS=5

# --- Concurrency ---
INFERENCE_THREADS=2
TORCH_NUM_THREADS=1
INFERENCE_TIMEOUT_SECONDS=2.0
MAX_PENDING_INFERENCES=256
UVICORN_WORKERS=1

# --- Grafana (Docker Compose) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
